{
  "name": "ts-space-demo-react-client",
  "version": "0.0.1-alpha.0",
  "description": "Implementation of a React client for the space DSL",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LionWeb-io/space-demo.git"
  },
  "bugs": {
    "url": "https://github.com/LionWeb-io/space-demo/issues"
  },
  "source": "src/index.html",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "scripts": {
    "clean": "npx rimraf dist node_modules",
    "check": "tsc --noEmit",
