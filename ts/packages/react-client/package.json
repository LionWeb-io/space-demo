    "preprod": "npm run build",
    "prod": "http-server dist/ --port 1234"
  },
  "dependencies": {
    "@lionweb/class-core": "0.10.0-beta.3",
    "@lionweb/core": "0.10.0-beta.3",
    "@lionweb/delta-protocol-client": "0.10.0-beta.3",
    "@lionweb/delta-protocol-low-level-client-browser": "0.10.0-beta.3",
    "@lionweb/json": "0.10.0-beta.3",
    "mobx": "6.16.1",
    "mobx-react": "9.2.2",
    "nanoid": "6.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@parcel/transformer-typescript-tsc": "2.16.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "http-server": "14.1.1",
    "parcel": "2.16.4",
    "typescript": "6.0.3"
  }
}
